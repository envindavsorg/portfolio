  "scripts": {
    "i18n:compile": "tsx --tsconfig ./tsconfig.scripts.json src/scripts/compile-i18n.mts",
    "predev": "pnpm i18n:compile",
    "dev": "next dev -p 1408",
    "prebuild": "pnpm i18n:compile",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 1408",
    "types": "tsc --noEmit --pretty",
    "deps": "npx depcheck",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "registry:internal": "tsx --tsconfig ./tsconfig.scripts.json src/scripts/build-registry.mts",
    "registry:build": "pnpm registry:internal && shadcn build ./src/__registry__/registry.autogenerated.json",
    "capture:run": "ENV_TYPE=capture next dev -p 1409",
    "capture:script": "tsx --tsconfig ./tsconfig.scripts.json src/scripts/capture.ts",
    "capture:components": "tsx --tsconfig ./tsconfig.scripts.json src/scripts/capture-components.ts",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "ANALYZE=true next build",
    "knip": "knip",
    "prepare": "lefthook install"
  },
