{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",

  // Biome remplace oxlint + oxfmt + ultracite : un seul outil, une seule
  // version, et surtout un seul endroit où le niveau d'exigence est décidé.
  //
  // C'est ce dernier point qui a motivé le retour. Avec ultracite, la sévérité
  // des règles venait d'un préréglage amont : passer de 7.8.1 à 7.10.3 a
  // transformé 276 avertissements en erreurs sur 137 fichiers, sans qu'aucun
  // commit du dépôt ne change. Un standard qu'on ne contrôle pas n'est pas un
  // standard, c'est une dépendance de plus.
  //
  // Le fichier est en `.jsonc` justement pour porter ces raisons.
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    // `.gitignore` fait déjà le tri : node_modules, .next, src/paraglide…
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "**",
      "!next-env.d.ts",
      "!src/__registry__",
      "!public/r",
      "!pnpm-lock.yaml"
    ]
  },

  // `lineWidth: 70` reprend le `printWidth` d'oxfmt. Ce n'est pas un détail :
  // c'est ce qui donne au dépôt ses lignes courtes, et le reprendre tel quel
  // fait que la bascule vers Biome ne reformate que 10 fichiers au lieu des
  // 150 qu'un oxfmt 0.63 aurait touchés.
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 70
  },

  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },

  "json": {
    "formatter": { "enabled": true }
  },

  "css": {
    "formatter": { "enabled": true },
    // Sans ça, `globals.css` produit 26 erreurs de syntaxe : `@plugin`,
    // `@theme`, `@custom-variant` et `@utility` ne sont pas du CSS standard.
    // Biome sait les lire, c'est juste éteint par défaut — l'exclure du
    // périmètre aurait laissé la feuille sans relecture du tout.
    "parser": { "tailwindDirectives": true }
  },

  "linter": {
    "enabled": true,
    "rules": {
      // `preset` remplace `recommended`, déprécié en 2.5 et supprimé au
      // prochain majeur
      "preset": "recommended",

      "a11y": {
        // Décisions REPRISES de l'ancien oxlint.config.ts, pas inventées ici :
        // `jsx-a11y/label-has-associated-control` y était déjà désactivée.
        "noLabelWithoutControl": "off",
        // idem `jsx-a11y/heading-has-content`
        "useHeadingContent": "off",

        // Ci-dessous : des règles qu'oxlint ne signalait qu'en avertissement, ou
        // pas du tout, et qui sont désormais BLOQUANTES.
        //
        // Elles ont d'abord été posées en `warn` le temps d'instruire les 116
        // signalements du passage à Biome. Ce travail est fait : ce qui était un
        // vrai défaut est corrigé, ce qui n'en était pas un porte une suppression
        // datée et argumentée à son emplacement, ou une exception de répertoire
        // ci-dessous. Un avertissement que personne ne lit ne garde rien —
        // laisser ces règles en `warn` aurait juste reconstitué la situation
        // qu'on venait de quitter.
        "noAriaHiddenOnFocusable": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useKeyWithMouseEvents": "error",

        /**
         * `role="group"` + `aria-label` est un motif ARIA VALIDE, pas un défaut.
         *
         * Les cinq sites sont des groupes nommés de boutons bascules (drapeaux de
         * regex, algorithme de hachage, préréglages cron) et le primitif
         * générique `Field`. Biome propose `<fieldset>`, qui serait faux ici :
         * `<fieldset>` groupe des CHAMPS de formulaire, attend un `<legend>` pour
         * son nom, et impose une mise en forme par défaut qu'un primitif de mise
         * en page ne peut pas porter.
         *
         * La seule liste qui gagnait à changer a changé : les rubriques d'une
         * page de tag sont devenues un vrai `<ul>`/`<li>`, ce qui annonce leur
         * nombre — un groupe ne le fait pas.
         */
        "useSemanticElements": "off"
      },

      "complexity": {
        "noImportantStyles": "error"
      },

      "correctness": {
        // `react-hooks/exhaustive-deps` était déjà en avertissement sous oxlint
        "useExhaustiveDependencies": "error"
      },

      "performance": {
        // `next/no-img-element` : avertissement sous oxlint
        "noImgElement": "error"
      },

      "security": {
        // reprise de `react/no-danger: off` : le rendu MDX passe par du HTML
        // déjà assaini en amont
        "noDangerouslySetInnerHtml": "off"
      },

      "style": {
        "noDescendingSpecificity": "error",
        // `next/no-head-element` : `RootDocument` rend son propre <head>, c'est
        // le patron « multiple root layouts » de l'App Router
        "noHeadElement": "off"
      },

      "suspicious": {
        "noArrayIndexKey": "error",
        // `console.error` et `console.warn` restent permis : ce sont les deux
        // seuls usages du dépôt, dans un `componentDidCatch` et un `catch`
        // autour de la lecture audio. La règle est là pour le `console.log`
        // oublié, pas pour museler un rapport d'erreur.
        "noConsole": {
          "level": "error",
          "options": { "allow": ["error", "warn"] }
        }
      }
    }
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        // reprend le tri de clés qu'oxlint appliquait aux objets
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },

  "overrides": [
    {
      // Icônes animées : 43 signalements, UN seul motif.
      //
      // Chaque icône enveloppe son `<svg aria-hidden>` dans un `<div>` qui porte
      // `onMouseEnter`/`onMouseLeave`. Ces gestionnaires ne déclenchent RIEN
      // d'autre qu'une animation décorative — il n'y a aucune action à exposer,
      // donc rien qu'un utilisateur au clavier puisse manquer.
      //
      // Mesuré en cherchant à satisfaire la règle proprement : `role="presentation"`
      // et `aria-hidden="true"` ne la satisfont PAS, `role="none"` oui — une
      // incohérence de Biome, ces deux rôles étant synonymes, sur laquelle on ne
      // va pas s'appuyer. `role="img"` la satisfait aussi, mais exigerait un nom
      // accessible que des icônes décoratives ne doivent justement pas avoir :
      // ce serait moins accessible, pas plus.
      //
      // La règle reste ACTIVE partout ailleurs, où un div interactif est un vrai
      // défaut.
      "includes": [
        "src/components/motion/**",
        "src/components/primitives/Input.tsx",
        "src/components/primitives/Command.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": { "noStaticElementInteractions": "off" }
        }
      }
    },
    {
      // Rendu CARACTÈRE par caractère, jeton par jeton, ou liste figée.
      //
      // Là où une clé stable existait, elle a été posée : `key={skill}`,
      // `key={activity.date}`, `key={d}` pour un tracé, `key={match.index}`.
      // Ce qui reste est d'une autre nature — l'index n'y est pas un pis-aller,
      // il DISTINGUE des contenus identiques :
      //
      // - `PixelHeading`, `TextAnimate` : un même caractère ou segment revient
      //   plusieurs fois dans un titre, les clés collisionneraient sans l'index ;
      // - `JSONFormatter`, `DiffViewer` : les jetons de coloration et les lignes
      //   vides se répètent ;
      // - `RegexTester` : l'index d'un groupe de capture EST son identité, c'est
      //   le `$1` affiché ;
      // - `OverviewContent`, `GraphLegend` : tableaux constants, jamais réordonnés.
      "includes": [
        "src/components/blocks/PixelHeading.tsx",
        "src/components/blocks/TextAnimate.tsx",
        "src/components/utils/DiffViewer.tsx",
        "src/components/utils/JSONFormatter.tsx",
        "src/components/utils/RegexTester.tsx",
        "src/app/(fr)/(content)/(root)/_components/overview/OverviewContent.tsx",
        "src/app/(fr)/(content)/(root)/_components/commits/graph/GraphLegend.tsx",
        "src/app/(fr)/(content)/(root)/_components/experiences/ExperienceItem.tsx",
        "src/app/(fr)/(content)/(root)/_components/projects/ProjectItem.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      // `!important` dans une feuille d'impression et sous
      // `prefers-reduced-motion` : les deux cas où c'est la pratique correcte.
      //
      // Les 12 occurrences sont là pour battre des utilitaires Tailwind qu'aucune
      // spécificité ne surpasse (`.min-h-svh`, `[data-print="hide"]`), pour
      // couper net les animations de transition de vue, et pour reprendre la main
      // sur le greffon `@tailwindcss/typography` dans `.prose`. Les retirer
      // casserait l'impression — dont le dépôt teste le rendu.
      //
      // `noDescendingSpecificity` vise les mêmes blocs : une feuille
      // d'impression réécrit délibérément des sélecteurs déclarés plus haut.
      "includes": ["src/app/globals.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      // Un script de build et un test de bout en bout écrivent sur stdout par
      // CONSTRUCTION : `compile-i18n.mts` annonce le nombre de messages
      // compilés, `budget.spec.ts` journalise chaque poids mesuré — et cette
      // trace est précisément ce qui a permis de découvrir que /articles pesait
      // 707 Kio en CI contre 518 en local. Interdire la console ici reviendrait
      // à supprimer le résultat.
      "includes": ["src/scripts/**", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Le tri de clés n'a pas de sens dans un fichier de configuration, où
      // l'ordre est conventionnel : il voulait réordonner `tsconfig.json`.
      "includes": ["**/*.json", "**/*.jsonc"],
      "assist": {
        "actions": {
          "source": { "useSortedKeys": "off" }
        }
      }
    }
  ]
}
